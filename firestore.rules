rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // Core Helpers: Strict Single-Owner Lock + Resilient Lightweight Guards
    // -------------------------------------------------------------------------
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128;
    }

    // Strict verified-email whitelist + UID path ownership gate
    function isAuthorizedOwner(userId) {
      return isSignedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email is string
        && request.auth.token.email.lower() == 'herozboy@gmail.com'
        && request.auth.uid == userId;
    }

    function isValidStory(data, userId) {
      return data.ownerId is string
        && data.ownerId == request.auth.uid
        && data.ownerId == userId
        && (!('title' in data) || (data.title is string && data.title.size() <= 300))
        && (!('glossary' in data) || (data.glossary is string && data.glossary.size() <= 8000))
        && (!('isDeleted' in data) || data.isDeleted is bool);
    }

    function isValidSection(data, userId, storyId) {
      return data.ownerId is string
        && data.ownerId == request.auth.uid
        && data.ownerId == userId
        && data.storyId is string
        && data.storyId == storyId
        && (!('content' in data) || (data.content is string && data.content.size() <= 200000))
        && (!('versions' in data) || (data.versions is list && data.versions.size() >= 1 && data.versions.size() <= 50))
        && (!('audioUrl' in data) || (data.audioUrl is string && data.audioUrl.size() <= 2048))
        && (!('storagePath' in data) || (data.storagePath is string && data.storagePath.size() <= 512))
        && (!('audioId' in data) || (data.audioId is string && data.audioId.size() <= 128))
        && (!('isDeleted' in data) || data.isDeleted is bool);
    }

    function isValidTrashedSection(data, userId) {
      return data.ownerId is string
        && data.ownerId == request.auth.uid
        && data.ownerId == userId
        && (!('parentStoryTitle' in data) || (data.parentStoryTitle is string && data.parentStoryTitle.size() <= 300))
        && (!('content' in data) || (data.content is string && data.content.size() <= 200000))
        && (!('versions' in data) || (data.versions is list && data.versions.size() >= 1 && data.versions.size() <= 50))
        && (!('audioUrl' in data) || (data.audioUrl is string && data.audioUrl.size() <= 2048))
        && (!('storagePath' in data) || (data.storagePath is string && data.storagePath.size() <= 512))
        && (!('audioId' in data) || (data.audioId is string && data.audioId.size() <= 128))
        && data.isDeleted == true;
    }

    // -------------------------------------------------------------------------
    // Collection: /users/{userId}/stories/{storyId}
    // -------------------------------------------------------------------------
    match /users/{userId}/stories/{storyId} {
      allow get: if isAuthorizedOwner(userId)
        && isValidId(userId)
        && isValidId(storyId);

      allow list: if isAuthorizedOwner(userId);

      allow create: if isAuthorizedOwner(userId)
        && isValidId(userId)
        && isValidId(storyId)
        && isValidStory(incoming(), userId);

      allow update: if isAuthorizedOwner(userId)
        && isValidId(userId)
        && isValidId(storyId)
        && isValidStory(incoming(), userId)
        && (!('ownerId' in existing()) || incoming().ownerId == existing().ownerId);

      allow delete: if isAuthorizedOwner(userId)
        && isValidId(userId)
        && isValidId(storyId);

      // -----------------------------------------------------------------------
      // Subcollection: /users/{userId}/stories/{storyId}/sections/{sectionId}
      // -----------------------------------------------------------------------
      match /sections/{sectionId} {
        allow get: if isAuthorizedOwner(userId)
          && isValidId(userId)
          && isValidId(storyId)
          && isValidId(sectionId);

        allow list: if isAuthorizedOwner(userId)
          && existing().ownerId == request.auth.uid
          && existing().storyId == storyId;

        allow create: if isAuthorizedOwner(userId)
          && isValidId(userId)
          && isValidId(storyId)
          && isValidId(sectionId)
          && isValidSection(incoming(), userId, storyId);

        allow update: if isAuthorizedOwner(userId)
          && isValidId(userId)
          && isValidId(storyId)
          && isValidId(sectionId)
          && isValidSection(incoming(), userId, storyId)
          && (!('ownerId' in existing()) || incoming().ownerId == existing().ownerId)
          && (!('storyId' in existing()) || incoming().storyId == existing().storyId);

        allow delete: if isAuthorizedOwner(userId)
          && isValidId(userId)
          && isValidId(storyId)
          && isValidId(sectionId);
      }
    }

    // -------------------------------------------------------------------------
    // Collection: /users/{userId}/trashedSections/{sectionId}
    // -------------------------------------------------------------------------
    match /users/{userId}/trashedSections/{sectionId} {
      allow get: if isAuthorizedOwner(userId)
        && isValidId(userId)
        && isValidId(sectionId);

      allow list: if isAuthorizedOwner(userId)
        && existing().ownerId == request.auth.uid;

      allow create: if isAuthorizedOwner(userId)
        && isValidId(userId)
        && isValidId(sectionId)
        && isValidTrashedSection(incoming(), userId);

      allow update: if false;

      allow delete: if isAuthorizedOwner(userId)
        && isValidId(userId)
        && isValidId(sectionId);
    }
  }
}
